    "chest_emblem": "white play-button emblem",
    "bottom": "dark charcoal shorts",
    "bottom_color": "#292733",
    "socks": "white socks",
    "shoes": "red and white sneakers",
    "accessories": [
      "dark crossbody bag"
    ]
