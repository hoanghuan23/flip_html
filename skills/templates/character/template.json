        "01-front-view.png",
        "02-left-profile.png",
        "03-right-profile.png",
        "04-back-view.png"
      ]
    },
    "poses": {
      "directory": "poses",
      "required": false,
      "priority": 70,
      "recursive": false,
      "extensions": [
        ".png",
        ".jpg",
        ".jpeg",
        ".webp"
      ],
      "selection": "Match expression, state, emotion, gesture and action in poses/ and asset_catalog.json."
    },
    "variants": {
      "directory": "design",
      "required": false,
      "priority": 80,
      "recursive": false,
      "extensions": [
        ".png",
        ".jpg",
        ".jpeg",
        ".webp"
      ],
      "selection": "Match scene role or costume in design/ and asset_catalog.json."
    }
  },
  "consistency": {
    "identity_lock": true,
    "preserve_hair_color": true,
    "preserve_hair_shape": true,
    "preserve_face_shape": true,
    "preserve_eye_style": true,
    "preserve_skin_tone": true,
