      "directory": "design",
      "required": true,
      "priority": 100,
      "recursive": false,
      "extensions": [
        ".png",
        ".jpg",
        ".jpeg",
        ".webp"
      ],
      "selection": "Use canonical_files for identity and camera angle; inspect design/ and asset_catalog.json for existing views and costume variants.",
